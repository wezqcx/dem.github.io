<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>New Year Crossword</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0a4a26, #1e8a4f);
            color: #fff;
            text-align: center;
            padding: 20px;
        }
        h1 {
            color: #d42426;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.4);
            margin-bottom: 10px;
        }
        .subtitle {
            font-style: italic;
            margin-bottom: 25px;
            color: #f0f0a0;
        }
        .grid-container {
            display: inline-block;
            background-color: #0d3b20;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 6px 12px rgba(0,0,0,0.5);
        }
        table {
            border-collapse: collapse;
            margin: 0 auto;
        }
        td {
            width: 40px;
            height: 40px;
            border: 2px solid #3a3a3a;
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            background-color: #f9f9f9;
            color: #222;
        }
        .black {
            background-color: #2c552c;
        }
        .number {
            position: relative;
            top: -18px;
            left: -15px;
            font-size: 10px;
            color: #ffcc00;
            font-weight: bold;
        }
        .clues {
            max-width: 600px;
            margin: 25px auto;
            background: rgba(10, 70, 30, 0.7);
            padding: 20px;
            border-radius: 10px;
            text-align: left;
        }
        .clues h2 {
            color: #ffd700;
            margin-top: 20px;
        }
        .clue {
            margin: 6px 0;
        }
        .star {
            color: gold;
        }
    </style>
</head>
